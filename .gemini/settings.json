{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "Bash\\(gh pr create.*\\)",
        "hooks": [
          {
            "type": "command",
            "command": "/nix/store/08aj8cfd2h762hy9l2gckk7ikdsg248r-gt-latest/bin/gt tap guard pr-workflow"
          }
        ]
      },
      {
        "matcher": "Bash\\(git checkout -b.*\\)",
        "hooks": [
          {
            "type": "command",
            "command": "/nix/store/08aj8cfd2h762hy9l2gckk7ikdsg248r-gt-latest/bin/gt tap guard pr-workflow"
          }
        ]
      },
      {
        "matcher": "Bash\\(git switch -c.*\\)",
        "hooks": [
          {
            "type": "command",
            "command": "/nix/store/08aj8cfd2h762hy9l2gckk7ikdsg248r-gt-latest/bin/gt tap guard pr-workflow"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "GT_SESSION_ID=${GT_SESSION_ID:-$(uuidgen)} GT_HOOK_SOURCE=startup /nix/store/08aj8cfd2h762hy9l2gckk7ikdsg248r-gt-latest/bin/gt prime --hook && /nix/store/08aj8cfd2h762hy9l2gckk7ikdsg248r-gt-latest/bin/gt mail check --inject"
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "GT_HOOK_SOURCE=compact /nix/store/08aj8cfd2h762hy9l2gckk7ikdsg248r-gt-latest/bin/gt prime --hook"
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/nix/store/08aj8cfd2h762hy9l2gckk7ikdsg248r-gt-latest/bin/gt mail check --inject"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/nix/store/08aj8cfd2h762hy9l2gckk7ikdsg248r-gt-latest/bin/gt costs record &"
          }
        ]
      }
    ]
  }
}
